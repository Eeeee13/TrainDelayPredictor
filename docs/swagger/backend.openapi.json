            }
          }
        }
      }
    },
    "/risk": {
      "get": {
        "tags": [
          "predictions"
        ],
        "summary": "List Risk",
        "description": "Served straight from the in-memory StateCache - no DB round trip -\nsince this is the endpoint a dashboard hits for its initial load and\nlatency matters.",
        "operationId": "list_risk_risk_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RiskAssessmentOut"
                  },
                  "type": "array",
                  "title": "Response List Risk Risk Get"
                }
              }
            }
          }
        }
      }
    },
    "/risk/{vehicle_id}": {
      "get": {
        "tags": [
          "predictions"
        ],
        "summary": "Get Risk",
        "operationId": "get_risk_risk__vehicle_id__get",
        "parameters": [
          {
            "name": "vehicle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Vehicle Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskAssessmentOut"
