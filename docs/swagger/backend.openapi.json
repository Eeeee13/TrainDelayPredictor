              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/risk/recompute": {
      "post": {
        "tags": [
          "predictions"
        ],
        "summary": "Recompute",
        "description": "Forces an immediate scheduler pass instead of waiting for the next\ntick - mainly useful for demos and for the jury to see the pipeline\nreact on demand.",
        "operationId": "recompute_risk_recompute_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecomputeResult"
                }
              }
            }
          }
        }
      }
    },
    "/ndtp-mapping": {
      "get": {
        "tags": [
          "ndtp-mapping"
        ],
        "summary": "Get Mapping",
        "description": "Get current NDTP unit_id to tr_id mapping.",
        "operationId": "get_mapping_ndtp_mapping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Get Mapping Ndtp Mapping Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ndtp-mapping"
        ],
        "summary": "Set Mapping",
        "description": "Set NDTP unit_id to tr_id mapping.",
        "operationId": "set_mapping_ndtp_mapping_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object",
                "title": "Mapping"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
