  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestAck": {
        "properties": {
          "accepted": {
            "type": "integer",
            "title": "Accepted"
          }
        },
        "type": "object",
        "required": [
          "accepted"
        ],
        "title": "IngestAck"
      },
      "RecomputeResult": {
        "properties": {
          "predictions_made": {
            "type": "integer",
            "title": "Predictions Made",
            "description": "number of RiskAssessments (re)computed in this pass"
          }
        },
        "type": "object",
        "required": [
          "predictions_made"
        ],
        "title": "RecomputeResult"
      },
      "ReplayClockIn": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "speed": {
            "type": "number",
            "title": "Speed"
          }
        },
        "type": "object",
        "required": [
          "start",
          "speed"
        ],
        "title": "ReplayClockIn"
      },
      "RiskAssessmentOut": {
        "properties": {
          "vehicle_id": {
            "type": "string",
            "title": "Vehicle Id"
          },
          "tr_id": {
            "type": "integer",
            "title": "Tr Id"
          },
          "target_stop_id": {
            "type": "integer",
            "title": "Target Stop Id"
          },
          "target_time_begin": {
            "type": "string",
            "format": "date-time",
            "title": "Target Time Begin"
          },
          "predicted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Predicted At"
          },
          "predicted_delay_s": {
            "type": "number",
            "title": "Predicted Delay S"
          },
          "risk_level": {
            "type": "string",
            "title": "Risk Level"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "delay_probability": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay Probability",
            "description": "Probability of delay strictly greater than 120 seconds at the target stop."
          }
        },
        "type": "object",
        "required": [
          "vehicle_id",
          "tr_id",
          "target_stop_id",
          "target_time_begin",
          "predicted_at",
          "predicted_delay_s",
          "risk_level",
          "reason",
          "source"
        ],
        "title": "RiskAssessmentOut"
      },
      "ScheduleBatchIn": {
        "properties": {
          "stops": {
            "items": {
              "$ref": "#/components/schemas/ScheduleStopIn"
            },
            "type": "array",
            "title": "Stops"
          },
          "route_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route Id"
          },
          "vehicle_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vehicle Id"
          }
        },
        "type": "object",
        "required": [
          "stops"
        ],
        "title": "ScheduleBatchIn"
      },
      "ScheduleStopIn": {
        "properties": {
          "tr_id": {
            "type": "integer",
            "title": "Tr Id"
          },
          "stop_id": {
            "type": "integer",
            "title": "Stop Id"
          },
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "scheduled_time": {
            "type": "string",
            "format": "date-time",
            "title": "Scheduled Time"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "manual_fill": {
            "type": "boolean",
            "title": "Manual Fill",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "tr_id",
          "stop_id",
          "seq",
          "scheduled_time"
        ],
        "title": "ScheduleStopIn"
      },
      "TelemetryBatchIn": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/TelemetryRecordIn"
            },
            "type": "array",
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "TelemetryBatchIn"
      },
      "TelemetryRecordIn": {
        "properties": {
          "vehicle_id": {
            "type": "string",
            "title": "Vehicle Id"
          },
          "event_time": {
            "type": "string",
            "format": "date-time",
            "title": "Event Time"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "speed": {
            "type": "number",
            "title": "Speed",
            "default": 0.0
          },
          "door_open": {
            "type": "boolean",
            "title": "Door Open",
            "default": false
          },
          "tr_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tr Id"
          },
          "location_valid": {
            "type": "boolean",
            "title": "Location Valid",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "vehicle_id",
          "event_time",
          "latitude",
          "longitude"
        ],
        "title": "TelemetryRecordIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VehicleDeviationOut": {
        "properties": {
          "vehicle_id": {
            "type": "string",
            "title": "Vehicle Id"
          },
          "tr_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tr Id"
          },
          "cur_dev_s": {
            "type": "integer",
            "title": "Cur Dev S"
          },
          "last_matched_stop_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Matched Stop Id"
          },
          "avg_speed_segment": {
            "type": "number",
            "title": "Avg Speed Segment"
          },
          "last_event_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Event Time"
          },
          "is_stationary": {
            "type": "boolean",
            "title": "Is Stationary"
          }
        },
        "type": "object",
        "required": [
          "vehicle_id",
          "tr_id",
          "cur_dev_s",
          "last_matched_stop_id",
          "avg_speed_segment",
          "last_event_time",
          "is_stationary"
        ],
        "title": "VehicleDeviationOut"
      }
    }
  }
}